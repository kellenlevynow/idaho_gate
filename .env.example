# ---------------------------------------------------------------
# Lead delivery (server side, set as Cloudflare Pages secrets, never commit)
# ---------------------------------------------------------------
# Email delivery through Resend (https://resend.com). Without a key AND
# without a webhook the quote form reports an honest failure and tells
# the visitor to call instead. It never pretends to submit.
RESEND_API_KEY=
# Verified sender on your Resend domain, e.g. "Idaho Gate Co. <quotes@idahogate.com>"
LEAD_FROM_EMAIL=
# Where every lead goes. Comma separated for several inboxes.
LEAD_TO_EMAIL=
# Optional per-path routing. Falls back to LEAD_TO_EMAIL when blank.
LEAD_TO_EMAIL_GATES=
LEAD_TO_EMAIL_FABRICATION=
LEAD_TO_EMAIL_COMMERCIAL=
LEAD_TO_EMAIL_REPAIRS=
# Optional CRM / Zapier / Make webhook. Receives the full JSON lead.
LEAD_WEBHOOK_URL=
# Optional shared secret sent as the X-Lead-Secret header to the webhook.
LEAD_WEBHOOK_SECRET=

# ---------------------------------------------------------------
# Tracking (public, baked in at build time). All off when blank.
# ---------------------------------------------------------------
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_LEAD_LABEL=
PUBLIC_GOOGLE_ADS_CALL_LABEL=
PUBLIC_META_PIXEL_ID=
# Optional call tracking swap script URL (CallRail, WhatConverts, etc.)
PUBLIC_CALL_TRACKING_SCRIPT=

# ---------------------------------------------------------------
# Private preview
# ---------------------------------------------------------------
# Password for the preview gate (Cloudflare Pages secret). Required while
# PUBLIC_LAUNCH_READY is not "true". Without it the site returns 503.
SITE_PASSWORD=

# Set to "true" to release the site publicly: the password gate steps aside,
# pages drop noindex and robots.txt opens up. Set it both on the Pages project
# and in the shell that runs the build.
PUBLIC_LAUNCH_READY=false
