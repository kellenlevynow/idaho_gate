---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Drawing from '@/components/Drawing.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FaqList from '@/components/FaqList.astro';
import RelatedLinks from '@/components/RelatedLinks.astro';
import ServiceMap from '@/components/ServiceMap.astro';
import QuickQuote from '@/components/QuickQuote.astro';
import { site, tierLabels } from '@/site.config';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/schema';

export async function getStaticPaths() {
  return (await getCollection('areas')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const path = `/service-area/${entry.id}/`;
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Service area', path: '/service-area/' }, { name: d.navTitle || d.title, path }];
const place = d.navTitle || d.title;
const schema = [
  breadcrumbSchema(crumbs),
  { ...serviceSchema({ name: `Custom gates and metal fabrication in ${place}`, description: d.description, path }), areaServed: d.towns.map((t) => ({ '@type': 'City', name: `${t}, ${d.state}` })) },
  ...(d.faqs.length ? [faqSchema(d.faqs)] : []),
];
---
<Base title={d.seoTitle} description={d.description} schema={schema} service={`area/${entry.id}`} cta={{ context: `area_${entry.id}`, heading: `Planning a gate in<br />${place}?` }}>
  <section class="surface-dark grid-dark" data-track-location="area_hero">
    <div class="wrap grid items-center gap-10 py-10 lg:grid-cols-12 lg:gap-12 lg:py-16">
      <div class="lg:col-span-7">
        <Breadcrumbs crumbs={crumbs} />
        <p class="eyebrow mt-8 text-ember-400">{tierLabels[d.tier]} · {d.county} County, {d.state}</p>
        <h1 class="display-sm mt-5">{d.title}</h1>
        <p class="lede mt-6 max-w-2xl text-steel-200">{d.lede}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/quote/" class="btn btn-lg" data-cta="area_quote">Request a quote <Icon name="arrow" /></a>
          <a href={`tel:${site.contact.phoneTel}`} class="btn btn-lg btn-ghost-dark"><Icon name="phone" /> {site.contact.phoneDisplay}</a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-2" aria-label="Communities covered">
          {d.towns.map((t) => <li class="tech border border-white/20 px-3 py-1.5 text-steel-200">{t}</li>)}
        </ul>
      </div>
      <div class="lg:col-span-5"><ServiceMap highlight={entry.id} compact /></div>
    </div>
  </section>

  {d.conditions.length > 0 && (
    <section class="surface-bone on-light section-tight">
      <div class="wrap">
        <p class="eyebrow text-ember-600">Local conditions</p>
        <h2 class="h2 mt-4 max-w-2xl">What the ground and the weather ask of a gate here.</h2>
        <ol class="mt-10 grid gap-px bg-ink-900/15 sm:grid-cols-2 lg:grid-cols-4">
          {d.conditions.map((c, i) => (
            <li class="bg-bone p-6">
              <span class="tech text-ember-600">{String(i + 1).padStart(2, '0')}</span>
              <p class="h4 mt-3">{c.title}</p>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-steel-500">{c.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section class="surface-paper on-light section-tight">
    <div class="wrap grid gap-12 lg:grid-cols-12">
      <article class="prose-gate lg:col-span-7"><Content /></article>
      <aside class="lg:col-span-4 lg:col-start-9">
        <div class="space-y-8 lg:sticky lg:top-[calc(var(--header-h)+1.5rem)]">
          {d.jurisdictions.length > 0 && (
            <div class="sheet bg-white p-6">
              <p class="tech text-steel-500">Who to ask</p>
              <ul class="mt-3">
                {d.jurisdictions.map((j) => <li class="border-t border-ink-900/10 py-3 text-[0.95rem] leading-snug first:border-t-0">{j}</li>)}
              </ul>
              <p class="mt-3 border-t border-ink-900/10 pt-3 text-[0.8rem] leading-snug text-steel-500">Rules are local and change. We confirm requirements for your address during quoting. <a class="underline" href="/resources/permits-hoa-and-fire-access/">Read the guide</a>.</p>
            </div>
          )}
          {d.visual && (
            <div>
              <div class="sheet bg-white"><Drawing kind={d.visual.kind} preset={d.visual.preset} theme="light" dims={false} footings={false} /></div>
              <p class="tech mt-3 text-steel-500">Concept drawing · not a completed project</p>
            </div>
          )}
          <div class="surface-dark p-6" data-track-location="area_aside">
            <QuickQuote id="area" heading={`Quick note from ${place}`} city={d.kind === 'city' ? `${d.towns[0]}, ${d.state}` : ''} context={`area_${entry.id}`} />
          </div>
        </div>
      </aside>
    </div>
  </section>

  {d.faqs.length > 0 && (
    <section class="surface-bone on-light section-tight">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="eyebrow text-ember-600">Questions</p>
          <h2 class="h2 mt-4">Asked in {place}.</h2>
        </div>
        <div class="lg:col-span-8"><FaqList faqs={d.faqs} /></div>
      </div>
    </section>
  )}
  <RelatedLinks paths={d.related} tone="light" />
</Base>
