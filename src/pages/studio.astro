---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Drawing from '@/components/Drawing.astro';
import { finishes } from '@/three/finish-data';
import { breadcrumbSchema } from '@/lib/schema';

const groups = [
  { id: 'operation', label: 'How it opens', options: [['double-swing', 'Double swing'], ['single-swing', 'Single swing'], ['slide', 'Cantilever slide']] },
  { id: 'infill', label: 'Infill', options: [['ridgeline', 'Pickets and ridgeline panel'], ['pickets', 'Pickets'], ['slats', 'Horizontal slats'], ['plate', 'Privacy panel'], ['ranch', 'Ranch rails']] },
  { id: 'top', label: 'Top profile', options: [['arch', 'Arched'], ['flat', 'Flat']] },
  { id: 'posts', label: 'Posts', options: [['masonry', 'Stone pillars'], ['steel', 'Steel posts']] },
  { id: 'automation', label: 'Automation', options: [['yes', 'Automated'], ['no', 'Manual']] },
];
const defaults: Record<string, string> = { operation: 'double-swing', infill: 'ridgeline', top: 'arch', posts: 'masonry', automation: 'yes' };
---
<Base
  title="Gate studio: configure a custom gate in 3D"
  description="Configure a concept gate in 3D. Change how it opens, the infill, posts and finish, view it exploded or as a drawing, then send it with your quote."
  cta={{ heading: 'Like what you built? <br />We can draw it for real.', body: 'The studio is a starting point. Send the design and we will measure your opening, adjust it to your site and come back with a drawing and a written quote.' }}
  schema={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Gate studio', path: '/studio/' }])]}
  service="studio"
>
  <section class="surface-dark" data-track-location="studio">
    <div class="wrap py-10 lg:py-14">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow text-ember-400">Gate studio</p>
          <h1 class="display-sm mt-4">Configure a gate.</h1>
          <p class="mt-4 max-w-2xl text-steel-200">Pick how it opens, what fills the frame and how it is finished. Drag to orbit. Every option here is something we build. Sizes and details get worked out on your site.</p>
        </div>
        <p class="concept-tag self-end text-steel-300" style="align-self:flex-end">Concept visualization · not a completed project</p>
      </div>

      <div class="mt-8 grid gap-8 lg:grid-cols-12" data-studio>
        <div class="self-start lg:sticky lg:top-[calc(var(--header-h)+1rem)] lg:col-span-8">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/12 pb-3">
            <div class="flex gap-1" role="tablist" aria-label="View">
              <button type="button" class="tab is-on" role="tab" aria-selected="true" aria-controls="view-3d" id="tab-3d" data-view="3d">3D model</button>
              <button type="button" class="tab" role="tab" aria-selected="false" aria-controls="view-elev" id="tab-elev" data-view="elev">Elevation</button>
              <button type="button" class="tab" role="tab" aria-selected="false" aria-controls="view-plan" id="tab-plan" data-view="plan">Plan</button>
            </div>
            <div class="flex flex-wrap gap-2" data-tools>
              <button type="button" class="tool" aria-pressed="false" data-toggle="exploded">Exploded</button>
              <button type="button" class="tool" aria-pressed="false" data-toggle="drawing">Line drawing</button>
              <button type="button" class="tool" aria-pressed="false" data-toggle="open">Open gate</button>
              <button type="button" class="tool" data-reset>Reset view</button>
            </div>
          </div>
          <div class="sheet sheet-dark relative mt-4 aspect-[4/3] overflow-hidden bg-ink-900 sm:aspect-[16/10]">
            <div id="view-3d" role="tabpanel" aria-labelledby="tab-3d" class="absolute inset-0" data-panel="3d">
              <canvas class="h-full w-full touch-none" data-studio-canvas aria-label="Interactive 3D model of the configured gate. Drag to rotate."></canvas>
              <p class="tech pointer-events-none absolute bottom-3 left-4 text-steel-400" data-studio-hint>Drag to orbit · scroll or pinch to zoom</p>
              <div class="absolute inset-0 grid place-items-center bg-ink-900 p-6" data-studio-fallback>
                <div class="w-full max-w-3xl">
                  <Drawing preset="estate-ridgeline" theme="dark" titleBlock={false} decorative />
                  <p class="tech mt-3 text-center text-steel-400" data-studio-loading>Loading 3D model</p>
                </div>
              </div>
            </div>
            <div id="view-elev" role="tabpanel" aria-labelledby="tab-elev" class="absolute inset-0 grid place-items-center p-3 sm:p-6" data-panel="elev" hidden>
              <svg class="max-h-full w-full" data-svg="elev" role="img" aria-label="Elevation drawing of the configured gate"></svg>
            </div>
            <div id="view-plan" role="tabpanel" aria-labelledby="tab-plan" class="absolute inset-0 grid place-items-center p-3 sm:p-6" data-panel="plan" hidden>
              <svg class="max-h-full w-full" data-svg="plan" role="img" aria-label="Plan drawing of the configured gate"></svg>
            </div>
          </div>
          <p class="mt-4 text-[0.95rem] text-steel-300" aria-live="polite"><span class="tech mr-2 text-ember-400">Your design</span><span data-studio-summary></span></p>
        </div>

        <form class="lg:col-span-4" data-studio-form>
          {groups.map((g) => (
            <fieldset class="opt-group">
              <legend class="tech text-steel-400">{g.label}</legend>
              <div class="mt-2 flex flex-wrap gap-2">
                {g.options.map(([value, label]) => (
                  <label class="opt">
                    <input type="radio" name={g.id} value={value} checked={defaults[g.id] === value} />
                    <span>{label}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))}
          <fieldset class="opt-group">
            <legend class="tech text-steel-400">Clear opening <output class="ml-2 text-bone" data-out="width">16 ft</output></legend>
            <input class="range mt-3" type="range" name="width" min="10" max="24" step="1" value="16" aria-label="Clear opening width in feet" />
          </fieldset>
          <fieldset class="opt-group">
            <legend class="tech text-steel-400">Height <output class="ml-2 text-bone" data-out="height">6 ft</output></legend>
            <input class="range mt-3" type="range" name="height" min="4.5" max="7.5" step="0.5" value="6" aria-label="Gate height in feet" />
          </fieldset>
          <fieldset class="opt-group">
            <legend class="tech text-steel-400">Finish</legend>
            <div class="mt-2 grid gap-2">
              {finishes.map((f, i) => (
                <label class="finish">
                  <input type="radio" name="finish" value={f.key} checked={i === 0} />
                  <span class="finish-body">
                    <span class="swatch" style={`background:${f.swatch}`}></span>
                    <span><span class="block font-[620] [font-stretch:106%]">{f.name}</span><span class="block text-[0.82rem] text-steel-300">{f.note}</span></span>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>
          <a href="/quote/?studio=" class="btn btn-lg mt-6 w-full" data-studio-quote data-cta="studio_quote">Request a quote for this design <Icon name="arrow" /></a>
          <p class="mt-3 text-sm text-steel-400">Your configuration is sent with the request so we start from the same picture.</p>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  import '@/scripts/studio-page';
</script>

<style is:global>
  .tab, .tool {
    font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase;
    padding: 0.55rem 0.8rem; min-height: 2.5rem; color: var(--color-steel-300); background: none; cursor: pointer;
    border: 1px solid transparent; transition: color 0.15s, border-color 0.15s, background-color 0.15s;
  }
  .tab.is-on { color: var(--color-bone); border-bottom-color: var(--color-ember-400); }
  .tab:hover, .tool:hover { color: var(--color-bone); }
  .tool { border-color: rgb(255 255 255 / 0.18); }
  .tool[aria-pressed='true'] { background: var(--color-bone); color: var(--color-ink-900); border-color: var(--color-bone); }
  .opt-group { border: 0; padding: 0 0 1.15rem; margin: 0 0 1.15rem; border-bottom: 1px solid rgb(255 255 255 / 0.1); min-width: 0; }
  .opt { position: relative; cursor: pointer; }
  .opt input, .finish input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; cursor: pointer; margin: 0; }
  .opt span { display: inline-flex; align-items: center; min-height: 2.6rem; padding: 0.5rem 0.85rem; font-size: 0.9rem; font-weight: 560; border: 1px solid rgb(255 255 255 / 0.2); transition: all 0.15s; }
  .opt:hover span { border-color: rgb(255 255 255 / 0.5); }
  .opt input:checked + span { background: var(--color-bone); color: var(--color-ink-900); border-color: var(--color-bone); }
  .opt input:focus-visible + span, .finish input:focus-visible + .finish-body { outline: 2px solid var(--color-ember-400); outline-offset: 2px; }
  .finish { position: relative; display: block; cursor: pointer; }
  .finish-body { display: flex; align-items: center; gap: 0.85rem; padding: 0.6rem 0.75rem; border: 1px solid rgb(255 255 255 / 0.14); transition: border-color 0.15s; }
  .finish:hover .finish-body { border-color: rgb(255 255 255 / 0.4); }
  .finish input:checked + .finish-body { border-color: var(--color-ember-400); box-shadow: inset 0 0 0 1px var(--color-ember-400); }
  .swatch { width: 2.1rem; height: 2.1rem; flex: none; border: 1px solid rgb(255 255 255 / 0.3); }
  .range { width: 100%; accent-color: var(--color-ember-500); height: 1.6rem; }
</style>
