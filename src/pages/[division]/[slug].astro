---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Drawing from '@/components/Drawing.astro';
import ConceptRender from '@/components/ConceptRender.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FaqList from '@/components/FaqList.astro';
import RelatedLinks from '@/components/RelatedLinks.astro';
import TrustStrip from '@/components/TrustStrip.astro';
import { site } from '@/site.config';
import { enabledDivisions } from '@/data/nav';
import { gatePresets } from '@/data/gate-presets';
import { getServices, serviceSlug, servicePath } from '@/lib/content';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/schema';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((entry) => ({ params: { division: entry.data.division, slug: serviceSlug(entry) }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const division = enabledDivisions.find((x) => x.slug === d.division)!;
const { Content } = await render(entry);
const path = servicePath(entry);
const inquiry = d.inquiry || division.inquiry;
const slug = serviceSlug(entry);
const typeParam: Record<string, string> = {
  'sliding-gates': 'sliding', 'swing-gates': 'driveway-swing', 'driveway-gates': 'driveway-swing', 'estate-gates': 'driveway-swing',
  'modern-gates': 'driveway-swing', 'ranch-and-farm-gates': 'ranch', 'pedestrian-and-garden-gates': 'pedestrian',
};
const quoteHref = `/quote/?path=${inquiry}${typeParam[slug] ? `&type=${typeParam[slug]}` : ''}`;
const crumbs = [{ name: 'Home', path: '/' }, { name: division.name, path: `/${division.slug}/` }, { name: d.navTitle || d.title, path }];
const v = d.visual;
const isGate = v?.kind === 'gate';
const preset = isGate ? gatePresets[v!.preset] : null;
const schema = [
  breadcrumbSchema(crumbs),
  serviceSchema({ name: d.title, description: d.description, path }),
  ...(d.faqs.length ? [faqSchema(d.faqs)] : []),
];
---
<Base title={d.seoTitle} description={d.description} schema={schema} service={`${d.division}/${slug}`} cta={{ path: inquiry, context: slug }}>
  <section class="surface-dark grid-dark" data-track-location="service_hero">
    <div class="wrap grid items-center gap-10 py-10 lg:grid-cols-12 lg:gap-12 lg:py-16">
      <div class="lg:col-span-6">
        <Breadcrumbs crumbs={crumbs} />
        <p class="eyebrow mt-8 text-ember-400">{division.kicker} · {division.name}</p>
        <h1 class="display-sm mt-5">{d.title}</h1>
        <p class="lede mt-6 max-w-xl text-steel-200">{d.lede}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={quoteHref} class="btn btn-lg" data-cta="service_quote">{inquiry === 'repairs' ? 'Request service' : 'Request a quote'} <Icon name="arrow" /></a>
          <a href={`tel:${site.contact.phoneTel}`} class="btn btn-lg btn-ghost-dark"><Icon name="phone" /> {site.contact.phoneDisplay}</a>
        </div>
        <div class="mt-8"><TrustStrip /></div>
      </div>
      {v && (
        <div class="lg:col-span-6">
          <div class="sheet sheet-dark bg-ink-900">
            <Drawing kind={v.kind} preset={v.preset} view={v.view === 'plan' ? 'plan' : 'elevation'} theme="dark" />
          </div>
          <p class="tech mt-3 text-steel-400">Concept {v.view === 'plan' ? 'plan' : 'drawing'}{preset ? ` · ${preset.title}` : ''} · not for construction</p>
        </div>
      )}
    </div>
  </section>

  <section class="surface-paper on-light section-tight">
    <div class="wrap grid gap-12 lg:grid-cols-12">
      <article class="prose-gate lg:col-span-7">
        <Content />
      </article>
      <aside class="lg:col-span-4 lg:col-start-9">
        <div class="space-y-8 lg:sticky lg:top-[calc(var(--header-h)+1.5rem)]">
          {d.specs.length > 0 && (
            <div class="sheet bg-white p-6">
              <p class="tech text-steel-500">At a glance</p>
              <dl class="mt-3">
                {d.specs.map((s) => (
                  <div class="border-t border-ink-900/10 py-3 first:border-t-0">
                    <dt class="tech text-steel-500">{s.label}</dt>
                    <dd class="mt-1 text-[0.98rem] font-[560] leading-snug">{s.value}</dd>
                  </div>
                ))}
              </dl>
              <p class="mt-3 border-t border-ink-900/10 pt-3 text-[0.8rem] leading-snug text-steel-500">General guidance. Sizes and details are set on your site visit.</p>
            </div>
          )}
          <div class="surface-dark p-6" data-track-location="service_aside">
            <p class="h3">{inquiry === 'repairs' ? 'Gate giving you trouble?' : 'Have an opening in mind?'}</p>
            <p class="mt-2 text-[0.95rem] text-steel-300">A few details is enough. We call, visit, measure and send a drawing with a written quote.</p>
            <a href={quoteHref} class="btn mt-5 w-full" data-cta="service_aside_quote">Start a quote <Icon name="arrow" /></a>
            <a href={`tel:${site.contact.phoneTel}`} class="mt-4 flex items-center justify-center gap-2 font-[640] text-bone no-underline hover:text-ember-400"><Icon name="phone" /> {site.contact.phoneDisplay}</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  {isGate && preset && (
    <section class="surface-black section-tight" data-track-location="service_visuals">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div>
            <p class="eyebrow text-ember-400">See the concept</p>
            <h2 class="h2 mt-4 max-w-2xl">{preset.title}, rendered and drawn.</h2>
          </div>
          <a href="/studio/" class="link-arrow text-bone" data-cta="service_studio">Change it in the gate studio <Icon name="arrow" /></a>
        </div>
        <div class:list={['mt-10 grid gap-6', v!.view === 'both' ? 'lg:grid-cols-2' : 'lg:grid-cols-12']}>
          <ConceptRender name={v!.preset} alt={`Concept rendering: ${preset.title.toLowerCase()}`} class:list={['sheet sheet-dark overflow-hidden', v!.view === 'both' ? '' : 'lg:col-span-8 lg:col-start-3']} />
          {v!.view === 'both' && (
            <div>
              <div class="sheet sheet-dark bg-ink-900"><Drawing preset={v!.preset} view="plan" theme="dark" /></div>
              <p class="tech mt-3 text-steel-400">Concept plan · clearances to check on your site</p>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {d.options.length > 0 && (
    <section class="surface-bone on-light section-tight">
      <div class="wrap">
        <p class="eyebrow text-ember-600">Options</p>
        <h2 class="h2 mt-4 max-w-2xl">Ways to build it.</h2>
        <ol class="mt-10 grid gap-px bg-ink-900/15 sm:grid-cols-2 lg:grid-cols-4">
          {d.options.map((o, i) => (
            <li class="bg-bone p-6">
              <span class="tech text-ember-600">{String(i + 1).padStart(2, '0')}</span>
              <p class="h4 mt-3">{o.title}</p>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-steel-500">{o.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {d.faqs.length > 0 && (
    <section class="surface-paper on-light section-tight">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="eyebrow text-ember-600">Questions</p>
          <h2 class="h2 mt-4">What people ask about {(d.navTitle || d.title).toLowerCase()}.</h2>
          <a href="/faq/" class="link-arrow mt-6">All questions <Icon name="arrow" /></a>
        </div>
        <div class="lg:col-span-8"><FaqList faqs={d.faqs} /></div>
      </div>
    </section>
  )}

  <RelatedLinks paths={d.related} />
</Base>
