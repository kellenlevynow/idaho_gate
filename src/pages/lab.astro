---
import '@/styles/global.css';
import Drawing from '@/components/Drawing.astro';
import { presetKeys } from '@/data/gate-presets';
import { fabDrawings } from '@/lib/fab-drawings';
---
<html><body style="background:#333;padding:20px">
<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
{presetKeys.map((k, i) => <Drawing preset={k} theme={i % 2 ? 'light' : 'dark'} />)}
{['estate-ridgeline','slide-slat','swing-single'].map((k) => <Drawing preset={k} view="plan" theme="light" />)}
{Object.keys(fabDrawings).map((k, i) => <Drawing kind="fab" preset={k} theme={i % 2 ? 'light' : 'dark'} />)}
</div></body></html>
