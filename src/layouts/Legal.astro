---
import Base from './Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { breadcrumbSchema } from '@/lib/schema';
interface Props { title: string; description: string; path: string; updated: string }
const { title, description, path, updated } = Astro.props;
const crumbs = [{ name: 'Home', path: '/' }, { name: title, path }];
---
<Base title={title} description={description} schema={[breadcrumbSchema(crumbs)]} hideCta>
  <section class="surface-bone on-light">
    <div class="wrap py-10 lg:py-14">
      <Breadcrumbs crumbs={crumbs} tone="light" />
      <h1 class="h2 mt-8" style="font-size:clamp(2.1rem,4.4vw,3.6rem)">{title}</h1>
      <p class="tech mt-4 text-steel-500">Last updated {updated}</p>
    </div>
  </section>
  <section class="surface-paper on-light section-tight"><div class="wrap"><article class="prose-gate"><slot /></article></div></section>
</Base>
