  menu: 'M1.5 4.5h13M1.5 8h13M1.5 11.5h13',
  close: 'M3 3l10 10M13 3 3 13',
  chevron: 'M4 6l4 4 4-4',
  check: 'M2.5 8.5 6.2 12 13.5 4',
  plus: 'M8 2.5v11M2.5 8h11',
  upload: 'M8 11V2.5M4.5 6 8 2.5 11.5 6M2.5 10.5v3h11v-3',
  mail: 'M1.8 3.5h12.4v9H1.8zM1.8 4l6.2 5 6.2-5',
